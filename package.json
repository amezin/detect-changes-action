    "minimatch": "10.1.1"
  },
  "devDependencies": {
    "@amezin/eslint-config-js-actions": "2.1.0",
    "@types/node": "24.10.9",
    "@vercel/ncc": "0.38.4",
    "typescript": "5.9.3"
  },
  "scripts": {
